{
  "name": "zotero-paper-radar",
  "type": "module",
  "version": "0.1.0",
  "description": "Paper Radar (论文雷达): monitor journal RSS feeds, AI-filter papers by research direction, and save high-value papers into Zotero with AI review notes.",
  "config": {
    "addonName": "Paper Radar",
    "addonID": "paper-radar@hjw",
    "addonRef": "paperRadar",
    "addonInstance": "PaperRadar",
    "prefsPrefix": "extensions.zotero.paperRadar"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaoxuan353/zotero-paper-radar.git"
  },
  "author": "xiaoxuan353",
  "bugs": {
    "url": "https://github.com/xiaoxuan353/zotero-paper-radar/issues"
  },
  "homepage": "https://github.com/xiaoxuan353/zotero-paper-radar#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^5.2.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@zotero-plugin/eslint-config": "^0.6.10",
    "chai": "^6.2.2",
    "eslint": "^9.39.2",
    "mocha": "^11.8.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.8.8",
    "zotero-types": "^4.1.3"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
